{
  "name": "modelproof",
  "productName": "ModelProof",
  "version": "0.1.0",
  "description": "中转站模型身份辨认 / 注水检测 — 基于 PAMELA 单token行为指纹方法 (arXiv:2607.10252)",
  "main": "src/main/main.js",
  "type": "module",
  "license": "MIT",
  "author": "cheng-yi-cc <450573577@qq.com>",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:reference": "node scripts/build-reference.mjs",
    "mock": "node scripts/mock-relay.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "cc.chengyi.modelproof",
    "productName": "ModelProof",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/pamela/prompts.json",
      "package.json",
      "README.md",
      "ATTRIBUTION.md"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ModelProof"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "maintainer": "cheng-yi-cc <450573577@qq.com>",
      "desktopName": "ModelProof",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.15.3"
  }
}
